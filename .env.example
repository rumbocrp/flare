# ==============================================================================
# FLARE Backend Environment Variables (SERVER-SIDE ONLY)
# ==============================================================================
# Copy this file to `.env` for local or VPS execution (`npm run server`).
# Node loads `.env` automatically via `--env-file-if-exists=.env`.
# NEVER expose exchange keys or API tokens with a `VITE_` prefix or in browser storage.
# ==============================================================================

# HTTP API & standalone SPA server binding (default: 127.0.0.1:3001)
HOST=127.0.0.1
PORT=3001
# Serve built `dist/` SPA bundle directly from `src/server/index.ts` (default: true)
FLARE_SERVE_STATIC=true

# ------------------------------------------------------------------------------
# Binance Spot Testnet (https://testnet.binance.vision/)
# - Trade-only Testnet API key; ALWAYS keep withdrawals disabled.
# - Leave blank to operate strictly in explicitly operator-funded PAPER mode.
# ------------------------------------------------------------------------------
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# ------------------------------------------------------------------------------
# Binance Spot LIVE Mainnet (https://api.binance.com) — DUAL-KEY ARMED
# - Requires ALL THREE variables below before a single live order can fire:
#   1) BINANCE_LIVE_KEY (trade-only, withdrawals DISABLED, IP-whitelisted)
#   2) BINANCE_LIVE_SECRET
#   3) FLARE_BINANCE_LIVE=true
# - Exchange-native protective OCO / STOP_LOSS_LIMIT orders are placed automatically
#   on every bot-auto entry with a stop price (set FLARE_BINANCE_PROTECTIVE_EXITS=false to disable).
# ------------------------------------------------------------------------------
FLARE_BINANCE_LIVE=false
BINANCE_LIVE_KEY=
BINANCE_LIVE_SECRET=
FLARE_BINANCE_PROTECTIVE_EXITS=true

# ------------------------------------------------------------------------------
# Polymarket CLOB Live Execution — DUAL-KEY ARMED
# ------------------------------------------------------------------------------
FLARE_POLYMARKET_LIVE=false
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# POLYMARKET_FUNDER=

# ------------------------------------------------------------------------------
# Operator API Authentication & RBAC
# - Set FLARE_AUTH_REQUIRED=true in shared/networked environments.
# - Format: comma-separated `token:role:subject` entries
#   Roles: admin | operator | trader | viewer | mt5-ea
#   Example: FLARE_API_TOKENS=op-secret-123:admin:alice,ea-secret-456:mt5-ea:mt5-terminal-1
# ------------------------------------------------------------------------------
FLARE_AUTH_REQUIRED=false
FLARE_API_TOKENS=

# ------------------------------------------------------------------------------
# External Operations Alerting (Telegram + Discord / Slack / Generic Webhook)
# - Fires automatically on KILL_SWITCH (always immediate), ERROR events, and
#   severity >= FLARE_ALERT_MIN_SEVERITY (default: error; options: error | warn | info).
# ------------------------------------------------------------------------------
FLARE_ALERT_WEBHOOK_URL=
FLARE_TELEGRAM_BOT_TOKEN=
FLARE_TELEGRAM_CHAT_ID=
FLARE_ALERT_MIN_SEVERITY=error
FLARE_ALERT_COOLDOWN_MS=30000

# ------------------------------------------------------------------------------
# Persistence Driver (`sqlite` default, or `postgres`)
# ------------------------------------------------------------------------------
FLARE_STATE_DRIVER=sqlite
# Optional override for SQLite database path (default: src/server/flare.db)
# FLARE_DB_PATH=src/server/flare.db
# Required only when FLARE_STATE_DRIVER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/flare
